[Unit]
Description=Fantasy Frontiers Node API
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/data/workspace/fantasy-frontiers/apps/server
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PORT=3001
Environment=DATABASE_PATH=data/fantasy-frontiers.sqlite
ExecStart=/usr/bin/node --import tsx src/server.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
